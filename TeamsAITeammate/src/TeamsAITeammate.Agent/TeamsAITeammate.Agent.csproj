<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>teams-ai-teammate-agent</UserSecretsId>
    <NoWarn>$(NoWarn);SKEXP0010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" Version="*-*" />
    <PackageReference Include="Microsoft.Agents.Builder" Version="*-*" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" Version="*-*" />
    <PackageReference Include="Microsoft.Agents.Extensions.Teams" Version="*-*" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.*" />
    <PackageReference Include="AspNetCoreRateLimit" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeamsAITeammate.Core\TeamsAITeammate.Core.csproj" />
    <ProjectReference Include="..\TeamsAITeammate.Infrastructure\TeamsAITeammate.Infrastructure.csproj" />
    <ProjectReference Include="..\TeamsAITeammate.AI\TeamsAITeammate.AI.csproj" />
  </ItemGroup>

</Project>
