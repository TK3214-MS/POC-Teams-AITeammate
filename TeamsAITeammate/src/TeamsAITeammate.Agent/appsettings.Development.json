{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Agents": "Debug"
    }
  },
  "Agents": {
    "Type": "SingleTenant",
    "MicrosoftAppId": "{{BOT_ID}}",
    "MicrosoftAppPassword": "{{BOT_PASSWORD}}",
    "MicrosoftAppTenantId": "{{TENANT_ID}}"
  },
  "AzureOpenAI": {
    "Endpoint": "https://your-openai.openai.azure.com/",
    "DeploymentName": "gpt-55",
    "FallbackDeploymentName": "gpt-54-mini",
    "ApiVersion": "2025-06-01-preview"
  },
  "CosmosDb": {
    "Endpoint": "https://localhost:8081",
    "DatabaseName": "TeamsAITeammate",
    "SessionsContainer": "sessions",
    "TranscriptsContainer": "transcripts",
    "KnowledgeContainer": "knowledge"
  },
  "AzureAISearch": {
    "Endpoint": "https://your-search.search.windows.net",
    "IndexName": "knowledge-index"
  },
  "BlobStorage": {
    "ContainerName": "documents"
  }
}
